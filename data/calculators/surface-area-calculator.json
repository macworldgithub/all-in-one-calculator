>\n<option value=\"micrometers\">micrometers</option>\n<option value=\"nanometers\">nanometers</option>\n<option value=\"angstroms\">angstroms</option>\n</select>\n</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"2\" style=\"padding-top:8px;\">\n<input name=\"rectcal\" type=\"submit\" value=\"Calculate\"/>\n<input onclick=\"clearForm(document.calform5);\" type=\"button\" value=\"Clear\"/>\n</td>\n</tr>\n</table>\n</form>\n</td><td align=\"center\" valign=\"top\"><img alt=\"prism\" height=\"100\" src=\"/img/surface-area/prism.svg\" width=\"82\"/></td></tr></table>\n<a name=\"capsule\"></a>\n<br/><h2>Capsule Surface Area</h2>\n<table><tr><td>\n<form action=\"surface-area-calculator.html#capsule\" name=\"calform6\">\n<table class=\"panel\">\n<tr>\n<td align=\"right\">Base Radius (r)</td><td> <input class=\"inhalf\" id=\"rcapsuleradius\" name=\"rcapsuleradius\" type=\"text\" value=\"\"/>\n<select name=\"rcapsuleradiusunit\">\n<option value=\"miles\">miles</option>\n<option value=\"yards\">yards</option>\n<option selected=\"\" value=\"feet\">feet</option>\n<option value=\"inches\">inches</option>\n<option value=\"kilometers\">kilometers</option>\n<option value=\"meters\">meters</option>\n<option value=\"centimeters\">centimeters</option>\n<option value=\"millimeters\">millimeters</option>\n<option value=\"micrometers\">micrometers</option>\n<option value=\"nanometers\">nanometers</option>\n<option value=\"angstroms\">angstroms</option>\n</select>\n</td>\n</tr>\n<tr>\n<td align=\"right\">Height (h)</td><td> <input class=\"inhalf\" id=\"rcapsuleheight\" name=\"rcapsuleheight\" type=\"text\" value=\"\"/>\n<select name=\"rcapsuleheightunit\">\n<option value=\"miles\">miles</option>\n<option value=\"yards\">yards</option>\n<option selected=\"\" value=\"feet\">feet</option>\n<option value=\"inches\">inches</option>\n<option value=\"kilometers\">kilometers</option>\n<option value=\"meters\">meters</option>\n<option value=\"centimeters\">centimeters</option>\n<option value=\"millimeters\">millimeters</option>\n<option value=\"micrometers\">micrometers</option>\n<option value=\"nanometers\">nanometers</option>\n<option value=\"angstroms\">angstroms</option>\n</select>\n</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"2\" style=\"padding-top:8px;\">\n<input name=\"capsule\" type=\"submit\" value=\"Calculate\"/>\n<input onclick=\"clearForm(document.calform6);\" type=\"button\" value=\"Clear\"/>\n</td>\n</tr>\n</table>\n</form>\n</td><td align=\"center\" valign=\"top\"><img alt=\"capsule\" height=\"126\" src=\"/img/surface-area/capsule.svg\" width=\"82\"/></td></tr></table>\n<a name=\"cap\"></a>\n<br/><h2>Cap Surface Area</h2>\n<p>Please provide any two values below to calculate.</p><table><tr><td>\n<form action=\"surface-area-calculator.html#cap\" name=\"calform7\">\n<table class=\"panel\">\n<tr>\n<td align=\"right\">Base Radius (r)</td><td> <input class=\"inhalf\" id=\"ccapbaseradius\" name=\"ccapbaseradius\" type=\"text\" value=\"\"/>\n<select name=\"ccapbaseradiusunit\">\n<option value=\"miles\">miles</option>\n<option value=\"yards\">yards</option>\n<option selected=\"\" value=\"feet\">feet</option>\n<option value=\"inches\">inches</option>\n<option value=\"kilometers\">kilometers</option>\n<option value=\"meters\">meters</option>\n<option value=\"centimeters\">centimeters</option>\n<option value=\"millimeters\">millimeters</option>\n<option value=\"micrometers\">micrometers</option>\n<option value=\"nanometers\">nanometers</option>\n<option value=\"angstroms\">angstroms</option>\n</select>\n</td>\n</tr>\n<tr>\n<td align=\"right\">Ball Radius (R)</td><td> <input class=\"inhalf\" id=\"ccapballradius\" name=\"ccapballradius\" type=\"text\" value=\"\"/>\n<select name=\"ccapballradiusunit\">\n<option value=\"miles\">miles</option>\n<option value=\"yards\">yards</option>\n<option selected=\"\" value=\"feet\">feet</option>\n<option value=\"inches\">inches</option>\n<option value=\"kilometers\">kilometers</option>\n<option value=\"meters\">m